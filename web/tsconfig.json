{
	"extends": "$app/tsconfig",
	"include": [
		".svelte-kit/ambient.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte",
		"scripts/**/*.ts",
		"vite.config.ts"
	],
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true
	}
}
